# The VPS's web front door (ports 80 and 443), installed by the map-https action.
#   map.88x31.app   -> BlueMap web map (port 8100), real certificate from Let's Encrypt
#   logs.88x31.app  -> log page (127.0.0.1:8090), self-signed certificate for Cloudflare "Full" mode
#   stats.88x31.app -> public stats page (files in /var/www/stats, rebuilt every 5 minutes by vps/stats-setup.sh), self-signed certificate for Cloudflare "Full" mode
#   status.88x31.app -> Uptime Kuma (127.0.0.1:3001, installed by vps/kuma-setup.sh), self-signed certificate for Cloudflare "Full" mode
#   bbs.88x31.app   -> 88x31 BBS web site (Synchronet, 127.0.0.1:8023); its browser terminal's websocket goes to 1123. Real certificate (DNS-only record, telnet uses the same name)
#   irc.88x31.app   -> Glowing Bear, WeeChat's web page (/var/www/glowing-bear); /weechat goes to WeeChat's relay (127.0.0.1:9001);
#                      /term is WeeChat's terminal in the browser (ttyd, with a login); all installed by vps/weechat-setup.sh; self-signed certificate for Cloudflare "Full" mode
#   anything else on port 80 (the bare IP) -> log page

map.88x31.app {
	reverse_proxy 127.0.0.1:8100
}

logs.88x31.app {
	tls internal
	reverse_proxy 127.0.0.1:8090
}

stats.88x31.app {
	tls internal
	root * /var/www/stats
	file_server
}

status.88x31.app {
	tls internal
	reverse_proxy 127.0.0.1:3001
}

bbs.88x31.app {
	@ws header Upgrade websocket
	reverse_proxy @ws 127.0.0.1:1123
	reverse_proxy 127.0.0.1:8023
}

irc.88x31.app {
	tls internal
	# /term: the real WeeChat in the browser, behind a login (the file is made by vps/weechat-setup.sh and stays on the server)
	import /etc/caddy/irc-term/*.caddy
	handle /weechat {
		reverse_proxy 127.0.0.1:9001
	}
	handle {
		root * /var/www/glowing-bear
		file_server
	}
}

:80 {
	reverse_proxy 127.0.0.1:8090
}
