# The VPS's web front door (ports 80 and 443), installed by the map-https action.
#   map.88x31.app   -> BlueMap web map (port 8100), real certificate from Let's Encrypt
#   logs.88x31.app  -> log page (127.0.0.1:8090), self-signed certificate for Cloudflare "Full" mode
#   stats.88x31.app -> public stats page (files in /var/www/stats, rebuilt every 5 minutes by vps/stats-setup.sh), self-signed certificate for Cloudflare "Full" mode
#   status.88x31.app -> Uptime Kuma (127.0.0.1:3001, installed by vps/kuma-setup.sh), self-signed certificate for Cloudflare "Full" mode
#   bbs.88x31.app   -> 88x31 BBS web site (Synchronet, 127.0.0.1:8023); its browser terminal's websocket goes to 1123. Real certificate (DNS-only record, telnet uses the same name)
#   irc.88x31.app   -> Weave, WeeChat's web page (/var/www/weave)
#                      /api is the API relay for Weave (127.0.0.1:9002), /weechat the older relay (127.0.0.1:9001); all installed by vps/weechat-setup.sh; self-signed certificate for Cloudflare "Full" mode
#   anything else on port 80 (the bare IP) -> log page

map.88x31.app {
	reverse_proxy 127.0.0.1:8100
}

logs.88x31.app {
	tls internal
	reverse_proxy 127.0.0.1:8090
}

stats.88x31.app {
	tls internal
	root * /var/www/stats
	file_server
}

status.88x31.app {
	tls internal
	reverse_proxy 127.0.0.1:3001
}

bbs.88x31.app {
	@ws header Upgrade websocket
	reverse_proxy @ws 127.0.0.1:1123
	reverse_proxy 127.0.0.1:8023
}

irc.88x31.app {
	tls internal
	# the older relay, for phone apps (WeeChat Android). The app sends no Origin header, and WeeChat only accepts
	# this site's origin (weechat-setup.sh), so Caddy adds it here. The relay password is still required.
	handle /weechat {
		reverse_proxy 127.0.0.1:9001 {
			header_up Origin https://irc.88x31.app
		}
	}
	# the API relay, for Weave: WeeChat only accepts it at exactly /api, so the path is passed on unchanged
	@api path /api /api/*
	handle @api {
		reverse_proxy 127.0.0.1:9002
	}
	# everything else is Weave. It may only talk to this site: no uploads, and no images or videos from links posted in chat.
	# (Weave's own page policy adds the rest; a browser applies both.)
	handle {
		header Content-Security-Policy "connect-src 'self' wss://irc.88x31.app; img-src 'self' data: blob:; media-src 'self' data: blob:; frame-ancestors 'none'"
		header Referrer-Policy no-referrer
		header Cache-Control no-cache
		root * /var/www/weave
		file_server
	}
}

:80 {
	reverse_proxy 127.0.0.1:8090
}
